# deps
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
.turbo/

# foundry
cache/
broadcast/
packages/contracts/out/

# registros de despliegue (generados por deploy/sync; efímeros por entorno)
packages/contracts/deployments/latest.json
# Registros crudos por cadena y salida de las pruebas: artefactos generados, no fuente.
# El registro canonico y validado es packages/shared/deployments/<chainId>.json
packages/contracts/deployments/*.json
packages/contracts/deployments/test/
packages/shared/deployments/*.json

# env & secrets
.env
.env.*
.env.vault
!.env.example

# despliegue local (scripts/dev/deploy-local.ps1): logs, PIDs y entorno generado
.deploy-logs/

# docker local data
postgres_data/
redis_data/

# misc
*.log
coverage/
.DS_Store
*.tsbuildinfo

# worker (checkpoint SQLite — runtime)
.data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# playwright
test-results/
playwright-report/
playwright/.cache/
.playwright-mcp/

# informes de auditoría/revisión: efímeros — las correcciones se aplican a las specs
# y el histórico queda en git; no se versionan para no mezclar proceso con producto
docs/REVISION-*.md

# Estado local de agentes/herramientas
.claude/

# Cobertura forge
packages/contracts/lcov.info

# Intermedios del pipeline de manuales (HTML imprimible y PDF A4): se regeneran con
# `pnpm --filter @hotel/web run manuals`. Los PDF públicos versionados son los de
# apps/web/public/manual/.
docs/pdf/
