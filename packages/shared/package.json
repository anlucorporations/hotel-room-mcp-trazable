{
  "name": "@hotel/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fuente única: constantes, tipos de dominio, configuración de red, ABI y registro de despliegues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "import": "./dist/domain.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "import": "./dist/deployments.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js"
    }
  },
  "files": [
    "dist",
    "deployments"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "provision:admin": "node --env-file=../../.env --import tsx scripts/create-admin.ts",
    "provision:reception": "node --env-file=../../.env --import tsx scripts/create-admin.ts --role RECEPTION_ROLE",
    "backfill:session-traces": "node --env-file=../../.env --import tsx scripts/backfill-session-traces.ts",
    "reset:index": "node --env-file=../../.env --import tsx scripts/reset-index.ts",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "reset:all": "node --env-file=../../.env --import tsx scripts/reset-all.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "viem": "^2.21.55",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hotel/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
