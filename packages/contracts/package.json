{
  "name": "@hotel/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contrato HotelNights (Foundry) + despliegue con bootstrap de roles",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "deploy:local": "forge script script/Deploy.s.sol:Deploy --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast --slow",
    "sync": "tsx scripts/sync-deployment.ts",
    "gen:abi": "tsx scripts/gen-abi.ts",
    "seed": "tsx scripts/seed.ts",
    "inject:data": "tsx scripts/inject-data.ts",
    "pin:images": "tsx scripts/pin-images.ts",
    "smoke": "bash scripts/smoke-deploy.sh",
    "e2e:m4": "tsx scripts/e2e/m4-buy-resale.ts",
    "e2e:m5": "tsx scripts/e2e/m5-checkin.ts",
    "e2e:m6": "tsx scripts/e2e/m6-automations.ts",
    "e2e:m7": "tsx scripts/e2e/m7-dashboard.ts",
    "clean": "forge clean && rm -rf .turbo"
  },
  "dependencies": {
    "@hotel/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "multiformats": "^13.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "viem": "^2.56.8"
  }
}
