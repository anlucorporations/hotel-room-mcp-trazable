{
  "name": "@hotel/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server del contrato: herramientas read-only + buildPurchaseTx (RF-12, CU-08)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@hotel/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pino": "^9.5.0",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hotel/config": "workspace:*",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
