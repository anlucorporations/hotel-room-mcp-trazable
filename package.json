{
  "name": "hotel-room",
  "version": "0.0.0",
  "private": true,
  "description": "Hotel Marina del Sol — noches de hotel como NFTs (piloto/PoC)",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contracts": "pnpm --filter @hotel/contracts test",
    "test:k6": "node --experimental-strip-types scripts/load-tests/run-load-test.ts",
    "test:e2e:amoy": "node --experimental-strip-types scripts/e2e/amoy-lifecycle.ts",
    "test:dr": "node --experimental-strip-types scripts/backup/restore-verify.ts",
    "contracts:build": "pnpm --filter @hotel/contracts build",
    "deploy:anvil": "pnpm --filter @hotel/contracts deploy:anvil",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "viem": "^2.52.0"
  }
}
