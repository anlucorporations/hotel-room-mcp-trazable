{
  "name": "hotel-room",
  "version": "0.0.0",
  "private": true,
  "description": "Hotel Marina del Sol — noches de hotel como NFTs (piloto/PoC)",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contracts": "pnpm --filter @hotel/contracts test",
    "contracts:build": "pnpm --filter @hotel/contracts build",
    "deploy:anvil": "pnpm --filter @hotel/contracts deploy:anvil",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
