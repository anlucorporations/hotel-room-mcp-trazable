{
  "name": "hotel-room",
  "version": "0.0.0",
  "private": true,
  "description": "Hotel Marina del Sol — noches de hotel como NFTs (piloto/PoC)",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "build:manuals": "pnpm --filter @hotel/web run manuals",
    "knowledge": "pnpm --filter @hotel/mcp run knowledge",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contracts": "pnpm --filter @hotel/contracts test",
    "test:load": "node --experimental-strip-types scripts/load-tests/run-load-test.ts",
    "test:load:k6": "k6 run scripts/load-tests/catalog-load.js",
    "test:e2e:m4": "pnpm --filter @hotel/contracts e2e:m4",
    "test:e2e:m5": "pnpm --filter @hotel/contracts e2e:m5",
    "test:e2e:m6": "pnpm --filter @hotel/contracts e2e:m6",
    "test:e2e:m7": "pnpm --filter @hotel/contracts e2e:m7",
    "test:e2e:f8": "pnpm --filter @hotel/contracts e2e:f8",
    "test:dr": "node --experimental-strip-types scripts/backup/restore-verify.ts",
    "contracts:build": "pnpm --filter @hotel/contracts build",
    "deploy:anvil": "pnpm --filter @hotel/contracts deploy:local",
    "inject:data": "pnpm --filter @hotel/contracts inject:data",
    "seed:market": "pnpm --filter @hotel/contracts seed:market",
    "verify:accounts": "pnpm --filter @hotel/contracts exec tsx scripts/verify-accounts.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "viem": "^2.52.0"
  }
}
