# =============================================================================
# .env.example — Hotel Marina del Sol: plataforma de noches NFT
#
# Plantilla de configuración. Copiar a `.env` (ignorado por Git).
#
# ENTORNO VIGENTE (decisión D-01 / D-10):
#   Red          Anvil local  http://127.0.0.1:8545   --chain-id 81234
#   Contrato     HotelNights (único; la pareja HotelNFT + HotelMarketplace es legacy)
#   Base de datos PostgreSQL (el equipo tiene la versión 18 instalada)
#   Cola / locks Redis-compatible (Memurai Developer en Windows: Redis 7.x)
#
# Esta plantilla es el CONTRATO de variables: el arranque de cada componente
# valida con zod y falla en cerrado (`loadEnv`). Si falta una variable marcada
# como [OBLIGATORIA], el proceso no arranca. No añadir valores por defecto en el
# código: si falta un secreto, debe fallar.
#
# PROHIBIDO: usar estos valores en producción. Las claves de Anvil son vectores
# públicos de prueba; en cualquier red real van a un gestor de secretos.
# =============================================================================

# ── Red y contrato ────────────────────────────────────────────────────────────
CHAIN_ID=81234                                    # [OBLIGATORIA] Anvil local (espejo de Besu)
RPC_URL=http://127.0.0.1:8545                     # [OBLIGATORIA] worker, mcp y web (servidor)
CONTRACT_ADDRESS=                                 # [OBLIGATORIA] dirección de HotelNights (la escribe el despliegue)
# DEPRECADAS (decisión D-02): la pareja legacy ya no se usa en el runtime.
# HOTEL_NFT_ADDRESS=
# HOTEL_MARKETPLACE_ADDRESS=
# HOTEL_NFT_CONTRACT_ADDRESS=                     # nombre antiguo que aún lee /api/admin/mint — se corrige en M1
# RETIRADA (decisión D-12): no hay failover multi-RPC.
# RPC_FALLBACK_URL=

# ── Despliegue y wallets ──────────────────────────────────────────────────────
# En Anvil, las claves por defecto de las cuentas 0-3 (públicas, solo desarrollo).
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
MINTER_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BURNER_BOT_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
RECEPTION_WALLET_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
GNOSIS_SAFE_ADDRESS=                              # multisig 2-of-3 (alcance D-11; pendiente B-7)

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# [OBLIGATORIA, SIN valor por defecto en el código] la cadena de conexión salía embebida
# (usuario y contraseña) en packages/shared/src/db/pool.ts; ahora `requireSecret` falla en
# cerrado si no está definida.
# [BLOQUEANTE B-1] el rol y la base deben existir en la instancia local:
#   CREATE ROLE hotel_admin LOGIN PASSWORD '<clave>';
#   CREATE DATABASE hotel_nft_dev OWNER hotel_admin;
DATABASE_URL=postgresql://hotel_admin:hotel_secret_2026@127.0.0.1:5432/hotel_nft_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis (cola BullMQ, locks y blocklist de JWT) ─────────────────────────────
# [OBLIGATORIA, SIN valor por defecto en el código] `requireSecret("REDIS_URL")`: la
# blocklist de JWT y el rate limiter de D-04 no pueden caer a un Redis local arbitrario.
# [BLOQUEANTE B-2] requiere un servidor Redis >= 5.0 (BullMQ rechaza versiones
# inferiores; el paquete `Redis.Redis` de winget es 3.0 y NO sirve).
REDIS_URL=redis://127.0.0.1:6379/0

# ── Seguridad y autenticación (decisión D-04) ─────────────────────────────────
# Sistema canónico ÚNICO: contraseña + TOTP obligatorio + JWT con rotación de refresh
# y blocklist en Redis. Protege TODAS las rutas /api/admin/* y /api/reception/*.
#
# NINGUNA de estas variables tiene valor por defecto en el código: `requireSecret()`
# (packages/shared/src/env) lanza MissingSecretError en el primer uso y el proceso falla
# en cerrado (CWE-798). Si ves un literal aquí, es un error: los secretos se generan con
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y en producción se leen de un gestor de secretos.
#
# [OBLIGATORIA] JWT_SECRET           firma HS256 del access token (>= 32 caracteres)
JWT_SECRET=
# [OBLIGATORIA] AES_SECRET_KEY       cifra la semilla TOTP de admin_users.totp_secret_enc
#                                    (hexadecimal de 32 bytes = 64 caracteres)
AES_SECRET_KEY=
# [OPCIONAL, CON RESPALDO EN AES_SECRET_KEY] SESSION_TRACE_SECRET
#   Clave del HMAC que pseudonimiza la IP y el user agent de los accesos de operadores
#   (admin_sessions, ADR-24). Si no está, se deriva de AES_SECRET_KEY; si tampoco existe,
#   la operación falla en cerrado. Se separa para poder rotarla sin tocar el cifrado TOTP.
SESSION_TRACE_SECRET=
# [OBLIGATORIA] CHECKIN_SECRET_KEY   cifra check_in_secret_enc (hex de 32 bytes)
CHECKIN_SECRET_KEY=
# [OBLIGATORIA] TICKET_SIGNING_SECRET firma el JWS del resguardo de check-in (>= 32 caracteres)
TICKET_SIGNING_SECRET=
# [OBLIGATORIA] SESSION_SECRET       firma la cookie de sesión SIWE (vía secundaria, ya no
#                                    autoriza el back-office ni protege ninguna API)
SESSION_SECRET=
SESSION_COOKIE=hotel_admin_session
SESSION_TTL_MS=3600000
JWT_ACCESS_EXPIRATION=900                         # 15 minutos (access token)
JWT_REFRESH_EXPIRATION=604800                     # 7 días (refresh token, con rotación)
# [RETIRADA] ADMIN_MFA_SECRET: el minteo re-confirma el TOTP contra la semilla CIFRADA del
# operador autenticado (admin_users.totp_secret_enc), no contra un secreto compartido de
# entorno. Ya no se lee ninguna variable con ese nombre.
# [RETIRADO] el secreto TOTP por defecto JBSWY3DPEHPK3PXP y las credenciales embebidas
# (SYSTEM_USERS) de /api/auth/* se eliminaron en M3: los operadores viven en la tabla
# `admin_users` (usuario, hash bcrypt y semilla TOTP cifrada).
# Aprovisionamiento (crea o rota un operador e imprime otpauth:// y códigos de rescate):
#   pnpm --filter @hotel/shared provision:admin -- --username admin@hotel.es --role DEFAULT_ADMIN_ROLE
#   pnpm --filter @hotel/shared provision:admin -- --username recepcion@hotel.es --role RECEPTION_ROLE
# PENDIENTE DE ALINEAR: el SRS describe JWT RS256; el código actual usa HS256 con JWT_SECRET.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ── Web (cliente: se inyectan en la compilación) ──────────────────────────────
NEXT_PUBLIC_CHAIN_ID=81234
NEXT_PUBLIC_SITE_URL=https://hotelmarinadelsol.es          # URL pública (Open Graph/Twitter); en local, http://localhost:3000
NEXT_PUBLIC_NETWORK=                              # vacío = Anvil; `besu` para la red privada
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CONTRACT_ADDRESS=                     # [OBLIGATORIA] misma dirección que CONTRACT_ADDRESS
NEXT_PUBLIC_DEPLOYMENT_BLOCK=0                    # bloque del despliegue: punto de inicio del escaneo de eventos
NEXT_PUBLIC_FAUCET_ADDRESS=                       # solo desarrollo; si falta, la UI del faucet se oculta
NEXT_PUBLIC_BLOCK_EXPLORER_URL=                   # Anvil no tiene explorador: vacío degrada honestamente
NEXT_PUBLIC_BLOCK_EXPLORER_NAME=
# RETIRADA (decisión D-07): la compra se unifica en HotelNights.
# NEXT_PUBLIC_MARKETPLACE_ADDRESS=

# ── Servicios propios ─────────────────────────────────────────────────────────
WORKER_HOST=127.0.0.1
WORKER_PORT=8787
WORKER_BASE_URL=http://127.0.0.1:8787             # la web consume /aggregates y /history del worker
MCP_HOST=127.0.0.1
MCP_PORT=8788
MCP_ALLOWED_HOSTS=127.0.0.1,localhost             # [OBLIGATORIA fuera de desarrollo]
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000
MONITOR_TARGETS=http://127.0.0.1:8787/health,http://127.0.0.1:8788/health

# ── Correo ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM="Hotel Marina del Sol <reservas@hotelmarinadelsol.es>"
OWNER_EMAIL="carlos@hotelmarinadelsol.es"         # destinatario de los avisos de venta
ADMIN_EMAIL="carlos@hotelmarinadelsol.es"         # lo lee el worker
ALERT_EMAIL="devops-alerts@hotelmarinadelsol.es"  # lo lee el monitor
DEVOPS_ALERT_EMAIL="devops-alerts@hotelmarinadelsol.es"

# ── Avisos push (decisión D-03: envío real) ───────────────────────────────────
# Las claves VAPID del repositorio eran inválidas (la pública contenía un espacio).
# Generar un par nuevo antes de activar la función.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:soporte@hotelmarinadelsol.es"

# ── Pases Apple y Google Wallet (alcance D-11) ────────────────────────────────
APPLE_PASS_TYPE_IDENTIFIER=pass.es.hotelmarinadelsol.room
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_WALLET_ISSUER_ID=

# ── Divisas ───────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=
BINANCE_FALLBACK_API_URL=https://api.binance.com/api/v3/ticker/price

# ── Asistente conversacional (v3: Vertex AI por defecto) ─────────────────────
# El proveedor se elige con ASSISTANT_PROVIDER:
#   vertex    (por defecto) — Gemini 2.5 Flash-Lite en europe-west1. Se autentica con la cuenta
#                            de servicio (ADC): NO necesita ningún secreto. ~2,6 USD/mes.
#   anthropic              — respaldo conmutable. Exige ANTHROPIC_API_KEY. ~82 USD/mes.
# Si se usa `vertex` sin proyecto resoluble, /api/assistant responde 503 (falla en cerrado) y la
# interfaz ofrece la navegación manual.
ASSISTANT_PROVIDER=vertex
VERTEX_MODEL=gemini-2.5-flash-lite
VERTEX_LOCATION=europe-west1
VERTEX_MAX_OUTPUT_TOKENS=512
# Solo para ASSISTANT_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Presupuesto y telemetría (H4, RNF-22/RNF-24):
#   ASSISTANT_MONTHLY_BUDGET_USD — techo estimado del mes. Por defecto 5.
#   ASSISTANT_BUDGET_MODE        — `soft` (solo avisa) o `hard` (responde 503 al agotarse).
#   ASSISTANT_MAX_INPUT_TOKENS   — presupuesto de entrada por petición. Por defecto 6000.
#   ASSISTANT_MAX_TURNS          — turnos de conversación que se conservan. Por defecto 12.
#   ASSISTANT_PRICE_*_PER_M      — sobrescribe la tarifa del modelo (USD por millón de tokens).
ASSISTANT_MONTHLY_BUDGET_USD=5
ASSISTANT_BUDGET_MODE=soft
ASSISTANT_MAX_INPUT_TOKENS=6000
ASSISTANT_MAX_TURNS=12
#   VERTEX_THINKING_BUDGET       — razonamiento de Gemini 2.5 (0 = desactivado, por defecto).
#                                  Medido en H4: con razonamiento el p95 era 2,86 s y truncaba
#                                  respuestas; sin él, 2,28 s y sin truncar.
VERTEX_THINKING_BUDGET=0
MCP_BASE_URL=http://127.0.0.1:8788
MCP_SHARED_SECRET=

# ── Observabilidad ────────────────────────────────────────────────────────────
# Decisión D-12: NO se instala Sentry. La observabilidad de errores es el logging
# estructurado en JSON. Las variables de Sentry se retiran de la plantilla.
LOG_LEVEL=info
NODE_ENV=development

# ── M6: automatismos (D-03, D-12) ─────────────────────────────────────────────
# NOTA (M7): una variable opcional DEJADA VACÍA (VAR=) equivale a no definirla; no es un valor
# inválido. El esquema del worker usa `emptyAsUndefined` para ello, porque antes `VAR=` rompía el
# arranque (`BURN_INTERVAL_MS: Number must be greater than 0`).
# Quema programada: hot-wallet DEDICADA con solo BURNER_ROLE (en local, la cuenta 2 de Anvil).
BURNER_WALLET_PRIVATE_KEY=                     # vacío = planificador de quema desactivado
BURNER_MIN_BALANCE_NATIVE=1                    # aviso si el saldo baja de este umbral
BURN_HOUR_LOCAL=12                             # hora LOCAL del hotel para la quema diaria
BURN_TIMEZONE=Europe/Madrid                    # zona del hotel (p. ej. UTC si facturara en UTC)
BURN_INTERVAL_MS=                              # SOLO dev/demo: ejecuta el ciclo cada N ms
EMAIL_RECONCILE_INTERVAL_MS=300000             # reconciliación de la cola única de correo
# Retención de datos (M9 · ADR-24): los plazos declarados se ejecutan de verdad.
RETENTION_INTERVAL_MS=21600000                 # cada 6 h: sesiones caducadas, códigos huérfanos y correos viejos
NOTIFICATIONS_RETENTION_DAYS=90                # días que se conservan las notificaciones ya enviadas
# Mantenimiento preventivo (F4 · D-54): aviso diario de las tareas vencidas.
MAINTENANCE_ALERT_EMAIL="mantenimiento@hotelmarinadelsol.es"  # destinatario; cae a DEVOPS_ALERT_EMAIL si falta
PREVENTIVE_HOUR_LOCAL=8                        # hora LOCAL del hotel a la que se avisa
PREVENTIVE_CHECK_INTERVAL_MS=3600000           # cada cuánto se comprueba la hora del aviso (1 h)
# Ventana de acuñación (F8 · D-17): aviso al responsable cuando una habitación publicada se queda sin
# noches libres en la ventana. Se envía UNA vez por episodio y habitación (se rearma al ampliarla).
MINT_WINDOW_ALERT_EMAIL="carlos@hotelmarinadelsol.es"  # destinatario; cae a ADMIN_EMAIL si falta
MINT_WINDOW_ALERT_HOUR_LOCAL=8                 # hora LOCAL del hotel a la que se comprueba
MINT_WINDOW_CHECK_INTERVAL_MS=3600000          # cada cuánto se comprueba la hora (1 h)
REORG_CONFIRMATIONS=1                          # 1 en Anvil; 32 en Polygon
SILENCE_THRESHOLD_MS=600000                    # silencio de bloques antes de alertar (10 min)
# Monitor (D-12): vigilancia de cadena y saldo de gas
CHAIN_RPC_URL=http://127.0.0.1:8545
GAS_WALLETS=quema=0x…,recepcion=0x…            # nombre=dirección, separados por comas
MIN_GAS_NATIVE=1
STALL_CYCLES=3
# Push real (RFC 8291/8292): sin las tres claves el push queda desactivado (se registra el motivo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:soporte@hotelmarinadelsol.es"
