# =============================================================================
# .env.example — Hotel Marina del Sol
#
# Plantilla de configuración. Copia a `.env` (o `.env.<entorno>`) y rellena los valores.
# NUNCA comitees valores reales: `.env*` está en `.gitignore` (excepto este ejemplo).
# El secret manager (`@hotel/shared/env`) valida con fail-fast al arrancar (T0.3).
# =============================================================================

# ── Red / contrato (común a worker, mcp, web) ────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=81234
CONTRACT_ADDRESS=

# ── Despliegue del contrato (CI / ops) — `forge script` ──────────────────────
# Clave del EOA que despliega (solo dev/CI usa cuentas de Anvil). En prod: secret manager.
DEPLOYER_PRIVATE_KEY=
# Admin definitivo que recibe los 6 roles (Safe en producción).
ADMIN_ADDRESS=
# Dirección receptora de ingresos y royalties.
TREASURY_ADDRESS=
# Royalty inicial en basis points (0–2000). Por defecto 1000 (10 %).
ROYALTY_BPS=1000

# ── Worker (mini-worker de eventos → email) ──────────────────────────────────
WORKER_HOST=0.0.0.0
WORKER_PORT=8787
# Intervalo de polling de eventos en ms (default 4000).
POLL_INTERVAL_MS=4000
# Bloque de despliegue del contrato (opcional). Si falta, se resuelve del registro de
# despliegues (deployments/<chainId>.json) o se usa 0.
DEPLOYMENT_BLOCK=
# Email de venta (SMTP) — se requiere a partir de T1.4.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# ── MCP server del contrato ──────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8788

# ── Web (cliente) — inyectadas en build (NEXT_PUBLIC_*) ──────────────────────
# Red activa: "besu" en producción; cualquier otro valor usa Anvil (dev).
NEXT_PUBLIC_NETWORK=
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=81234
# Dirección del contrato (en dev cae a la del primer deploy determinista de Anvil).
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Bloque de despliegue: inicio del escaneo getLogs del catálogo y «Mis noches» (ADR-09).
NEXT_PUBLIC_DEPLOYMENT_BLOCK=0

# ── Web (servidor) — back-office ─────────────────────────────────────────────
# Secreto HMAC de la sesión SIWE del back-office (CU-01). Obligatorio en producción.
SESSION_SECRET=
# Base del worker para histórico/dashboard (agregados precomputados, ADR-09).
WORKER_BASE_URL=http://127.0.0.1:8787

# ── Web / API route (asistente IA) ───────────────────────────────────────────
# Clave del LLM, usada solo server-side en el API route (T4.2). El MCP nunca la usa.
ANTHROPIC_API_KEY=

# ── IPFS pinning (metadata + imágenes) ───────────────────────────────────────
# JWT de Pinata si se usa Pinata como pinner (ADR-12). En dev puede usarse Kubo local.
PINATA_JWT=

# ── Observabilidad ───────────────────────────────────────────────────────────
LOG_LEVEL=info
