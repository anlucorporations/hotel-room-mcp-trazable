# =============================================================================
# .env.example — Hotel Marina del Sol: Plataforma NFT de Reservas
#
# Plantilla de configuración de entorno.
# Copia este archivo a `.env` (o `.env.local` / `.env.staging` / `.env.production`).
# NUNCA confirmes claves privadas ni credenciales reales en Git (`.env*` en `.gitignore`).
# =============================================================================

# ── Red Blockchain y Smart Contracts (Polygon) ────────────────────────────────
# Desarrollo local: Anvil (31337)
# Testnet: Polygon Amoy (80002)
# Producción: Polygon PoS (137)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
RPC_FALLBACK_URL=https://rpc-amoy.polygon.technology

# Direcciones desplegadas (obtenidas tras ejecutar Deploy.s.sol)
HOTEL_NFT_ADDRESS=
HOTEL_MARKETPLACE_ADDRESS=

# ── Wallets y Roles (Foundry / Relayer / Bot) ──────────────────────────────────
# En local (Anvil): Claves predeterminadas de cuentas 0, 1, 2 y 3.
# En Testnet/Prod: Custodia obligatoria en Google Cloud Secret Manager o Vault.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
MINTER_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BURNER_BOT_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
RECEPTION_WALLET_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Multisig Gnosis Safe 2-of-3 (DEFAULT_ADMIN_ROLE en producción)
GNOSIS_SAFE_ADDRESS=

# ── Base de Datos Relacional Off-chain (PostgreSQL 16) ─────────────────────────
DATABASE_URL=postgresql://hotel_admin:hotel_secret_2026@127.0.0.1:5432/hotel_nft_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Cola y Caché en Memoria (Redis 7) ──────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Criptografía y Seguridad Off-chain ────────────────────────────────────────
# Clave simétrica AES-256-GCM para cifrar secretos de QR (check_in_secret_enc).
# Debe ser un string hexadecimal de exactamente 64 caracteres (32 bytes).
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Claves asimétricas JWT (RS256) para autenticación de Administrador y Recepción
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRATION=900        # 15 minutos en segundos
JWT_REFRESH_EXPIRATION=604800    # 7 días en segundos

# ── Servicios Externos y APIs ─────────────────────────────────────────────────
# Sincronización de divisas (EUR)
COINGECKO_API_KEY=
BINANCE_FALLBACK_API_URL=https://api.binance.com/api/v3/ticker/price

# Notificaciones por Correo Electrónico (BullMQ / SMTP / SendGrid / Resend)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM="Hotel Marina del Sol <reservas@hotelmarinadelsol.es>"
OWNER_EMAIL="carlos@hotelmarinadelsol.es"

# Alertas Técnicas y de Infraestructura (DevOps / Bot Burner / Listener)
DEVOPS_ALERT_EMAIL="devops-alerts@hotelmarinadelsol.es"

# Web Push Notifications (Firebase Cloud Messaging / VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:soporte@hotelmarinadelsol.es"

# ── Pases Digitales Apple y Google Wallet ─────────────────────────────────────
# Apple Wallet: Requiere Apple Developer Account ($99/año) y Pass Type ID Certificate
APPLE_PASS_TYPE_IDENTIFIER=pass.es.hotelmarinadelsol.room
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=

# Google Wallet API
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_WALLET_ISSUER_ID=

# ── Observabilidad y Monitoreo ────────────────────────────────────────────────
# Sentry DSN para reporte centralizado de errores y excepciones
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
